{
  "name": "tldr-monorepo",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/extension",
    "packages/core",
    "packages/core-dom"
  ],
  "scripts": {
    "dev:web": "npm run build:core && npm run build:core-dom && npm --workspace apps/web run dev",
    "build:web": "npm run build:core && npm run build:core-dom && npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "build:core": "npm --workspace packages/core run build",
    "build:core-dom": "npm --workspace packages/core-dom run build",
    "build:extension": "npm --workspace apps/extension run build",
    "lint:extension": "npm --workspace apps/extension run lint"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  }
}
